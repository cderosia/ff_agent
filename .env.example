# ============================================================================
# TEMPLATE ONLY — safe to commit. Copy to `.env` and fill that in instead.
#
#     cp .env.example .env
#
# `.env` is gitignored. Never put real values in THIS file.
# ============================================================================


# ---------------------------------------------------------------------------
# ESPN  — covers both private leagues (family 779624, friends 371699)
# ---------------------------------------------------------------------------
# One set of cookies works for every ESPN league your account can see.
# These are session credentials for your whole ESPN account, not just fantasy.
# They typically last ~1 year, but logging out of ESPN everywhere kills them.
#
# Chrome, logged in at espn.com:
#   DevTools (Cmd+Opt+I) > Application > Storage > Cookies > https://www.espn.com
#
# SWID includes the curly braces — keep them.
# espn_s2 is long (~300 chars) and may contain % characters — that's normal,
# copy it exactly, don't decode it.

ESPN_S2=
ESPN_SWID=


# ---------------------------------------------------------------------------
# YAHOO — for the `work` league (137943), draft Aug 18
# ---------------------------------------------------------------------------
# From https://developer.yahoo.com/apps/  after creating an app.
# The refresh token is obtained once via a browser consent step; it then
# renews itself indefinitely as long as it's used periodically.

YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REFRESH_TOKEN=


# ---------------------------------------------------------------------------
# EMAIL — weekly report delivery
# ---------------------------------------------------------------------------
# Gmail will NOT accept your normal password. Create an App Password:
#   myaccount.google.com > Security > 2-Step Verification > App passwords
# It's a 16-character string; paste it with or without spaces.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
REPORT_TO=
